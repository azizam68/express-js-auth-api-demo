{
  "name": "express-js-auth-api-demo",
  "version": "1.0.0",
  "description": "Demo auth API using Express JS",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "check": "npm run build && npm run test:run",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",

    "db:seed:roles": "dotenv -e .env -- tsx seed/roles.seed.ts",
    "db:seed:users": "dotenv -e .env -- tsx seed/users.seed.ts",
    "db:seed:user-roles": "dotenv -e .env -- tsx seed/user-roles.seed.ts",
    "db:seed": "npm run db:seed:roles && npm run db:seed:users && npm run db:seed:user-roles",

    "db:seed:prod": "dotenv -e .env.production -- tsx seed/users.seed.ts",
    
    "db:seed:roles:test": "dotenv -e .env.test -- tsx seed/roles.seed.ts",
    "db:seed:users:test": "dotenv -e .env.test -- tsx seed/users.seed.ts",
    "db:seed:user-roles:test": "dotenv -e .env.test -- tsx seed/user-roles.seed.ts",
    "db:seed:test": "npm run db:seed:roles && npm run db:seed:users && npm run db:seed:user-roles",

    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "dotenv -e .env.test -- vitest",
    "test:run": "dotenv -e .env.test -- vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azizam68/express-js-auth-api-demo.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/azizam68/express-js-auth-api-demo/issues"
  },
  "homepage": "https://github.com/azizam68/express-js-auth-api-demo#readme",
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "path": "^0.12.7",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
