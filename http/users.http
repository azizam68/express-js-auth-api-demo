### Get users
GET http://localhost:3333/api/users


### Create user
POST http://localhost:3333/api/users
Content-Type: application/json

{
  "email": "alice33@example.com"
}


### Invalid email
POST http://localhost:3333/api/users
Content-Type: application/json

{
  "email": "not-an-email"
}


### Missing email
POST http://localhost:3333/api/users
Content-Type: application/json

{}

### Get user by ID
GET http://localhost:3333/api/users/8c801bf8-3069-4bae-86e7-0c138d83deb0

### Get user by Wrong ID 1 - format of ID is wrong
GET http://localhost:3333/api/users/1

### Get user by Wrong ID 2
GET http://localhost:3333/api/users/000000-d9ff-47c7-81e0-92c592c70140


### update user
PATCH http://localhost:3333/api/users/8dcc3f31-d9ff-47c7-81e0-92c592c70140
Content-Type: application/json

{
  "email": "new@example.com"
}

### update user
PUT http://localhost:3333/api/users/6fec1040-798b-44f0-bbe1-3506f6c214cd
Content-Type: application/json

{
  "email": "paut@example.com"
}

### delete user
DELETE http://localhost:3333/api/users/965952f8-b74a-4488-a18c-d105850e0ca6

### add role to a user
GET /api/users/8c801bf8-3069-4bae-86e7-0c138d83deb0/roles

### add role to a user
POST /api/users/8c801bf8-3069-4bae-86e7-0c138d83deb0/roles
Content-Type: application/json

{
  "roleId": "d750f6b1-a11d-47c9-bc55-797879aabdea"
}

### remove assigned role from a user
DELETE /api/users/8c801bf8-3069-4bae-86e7-0c138d83deb0/roles
Content-Type: application/json

{
  "roleId": "d750f6b1-a11d-47c9-bc55-797879aabdea"
}