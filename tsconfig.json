{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "files": [
    "src/app.d.ts"
  ],
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}